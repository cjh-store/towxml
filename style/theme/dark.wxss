/*正文样式*/
.h2w-dark {
  color:#ddd;
  background-color:#000;
}

/**标题**/
.h2w-dark .h2w__h1,
.h2w-dark .h2w__h2 {
    border-color:#3d3d3d;
}


/**表格**/
.h2w-dark .h2w__thead .h2w__tr {
    background-color:#1f1f1f;
}
.h2w-dark .h2w__table .h2w__tr:nth-child(2n){
    background-color:#090909;
}
.h2w-dark .h2w__th,
.h2w-dark .h2w__td {
    border-color:#333;
}


/**代码块**/
.h2w-dark .h2w__pre,
.h2w-dark .h2w__pre .h2w__code {
    background-color:#1b1b1b;
    border-color:#262626;
}

.h2w-dark .h2w__code {
    background-color:#272822;
    border-color:#1b1c18;
}


/**块元素**/
.h2w-dark .h2w__blockquote {
    border-left-color:#10230f;
}

/**内连元素**/
.h2w-dark .h2w__a {
    color:#1aad16; border-color:#4d804b;
}

.h2w-dark .h2w__hr {
    background-color:#242424;
}

.h2w-dark .h2w__mark {
    background:yellow;
    color:black;
}

.h2w-dark .h2w__g-callout {
  background-color:#1b1b1b;
  border-left-color:#333;
}
.h2w-dark .h2w__g-callout.callout--tip {
  border-left-color:#1aad16;
}
.h2w-dark .h2w__g-callout.callout--warning {
  border-left-color:#e6a23c;
}
.h2w-dark .h2w__g-callout.callout--danger {
  border-left-color:#f56c6c;
}
.h2w-dark .h2w__g-callout.callout--info {
  border-left-color:#909399;
}
.h2w-dark .h2w__g-callout.callout--note {
  border-left-color:#1aad16;
}

.h2w-dark .h2w__g-callout.callout--tblue,
.h2w-dark .h2w__g-callout.callout--tblue1 {
  background-color:#0b1722;
  border-color:#0f2a45;
  border-style:solid;
  border-width:1rpx;
  border-left-width:12rpx;
  box-shadow:0 8rpx 24rpx rgba(33, 150, 243, 0.18);
}
.h2w-dark .h2w__g-callout.callout--tblue { border-left-color:#0288D1; }
.h2w-dark .h2w__g-callout.callout--tblue1 { border-left-color:#2196F3; }

.h2w-dark .h2w__g-callout.callout--green,
.h2w-dark .h2w__g-callout.callout--orange,
.h2w-dark .h2w__g-callout.callout--yellow,
.h2w-dark .h2w__g-callout.callout--red,
.h2w-dark .h2w__g-callout.callout--blue {
  background-color:transparent;
}

.h2w-dark .h2w__g-callout.callout--green { border-left-color:#16a085; }
.h2w-dark .h2w__g-callout.callout--orange { border-left-color:#d35400; }
.h2w-dark .h2w__g-callout.callout--yellow { border-left-color:#d4ac0d; }
.h2w-dark .h2w__g-callout.callout--red { border-left-color:#c0392b; }
.h2w-dark .h2w__g-callout.callout--blue { border-left-color:#2980b9; }

.h2w-dark .h2w__u.blank-underline {
  color:#0080ff;
  border-bottom-color:#0080ff;
  background-color:#d9ecff;
}

.h2w-dark .h2w__todoCheckbox .wx-checkbox-input {
    background:#2e2e2e; border-color:#494949;
}
.h2w-dark .h2w__todoCheckbox .wx-checkbox-input.wx-checkbox-input-checked {
    background:green; border-color:#4d804b;
}
.h2w-dark .h2w__todoCheckbox .wx-checkbox-input.wx-checkbox-input-checked::before {
    color:white;
}
.h2w-dark .h2w__lineNum {
    color:#494949;
}

/**代码高亮样式**/
@import '../../parse/highlight/style/monokai.wxss';
