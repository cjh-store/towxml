/*正文样式*/
.h2w-light {
  color:#333;
  background-color:white;
}

/**标题**/
.h2w-light .h2w__h1,
.h2w-light .h2w__h2 {
    border-color:#eee;
}


/**表格**/
.h2w-light .h2w__thead .h2w__tr {
    background-color:#f6f8fa;
}
.h2w-light .h2w__table .h2w__tr:nth-child(2n){
    background-color:#fbfcfd;
}
.h2w-light .h2w__th,
.h2w-light .h2w__td {
    border-color:#dfe2e5;
}


/**代码块**/
.h2w-light .h2w__pre {
    background-color:#f6f8fa;
    border-color:#eaedf0;
}

.h2w-light .h2w__code {
    background-color:#f6f8fa;
    border-color:#eaedf0;
}


/**块元素**/
.h2w-light .h2w__blockquote {
    border-left-color:#dfe2e5;
}

/**内连元素**/
.h2w-light .h2w__a {
    color:#1aad16; border-color:#b9d9b8;
}

.h2w-light .h2w__hr {
    background-color:#eee;
}

.h2w-light .h2w__mark {
    background:yellow;
    color:black;
}

.h2w-light .h2w__g-callout {
  background-color:#f6f8fa;
  border-left-color:#dfe2e5;
}
.h2w-light .h2w__g-callout.callout--tip {
  border-left-color:#1aad16;
}
.h2w-light .h2w__g-callout.callout--warning {
  border-left-color:#e6a23c;
}
.h2w-light .h2w__g-callout.callout--danger {
  border-left-color:#f56c6c;
}
.h2w-light .h2w__g-callout.callout--info {
  border-left-color:#909399;
}
.h2w-light .h2w__g-callout.callout--note {
  border-left-color:#1aad16;
}

.h2w-light .h2w__g-callout.callout--tblue,
.h2w-light .h2w__g-callout.callout--tblue1 {
  background-color:#ffffff;
  border-color:#e6f4ff;
  border-style:solid;
  border-width:1rpx;
  border-left-width:12rpx;
  box-shadow:0 8rpx 24rpx rgba(33, 150, 243, 0.12);
}
.h2w-light .h2w__g-callout.callout--tblue { border-left-color:#0288D1; }
.h2w-light .h2w__g-callout.callout--tblue1 { border-left-color:#2196F3; }

.h2w-light .h2w__g-callout.callout--green,
.h2w-light .h2w__g-callout.callout--orange,
.h2w-light .h2w__g-callout.callout--yellow,
.h2w-light .h2w__g-callout.callout--red,
.h2w-light .h2w__g-callout.callout--blue {
  background-color:transparent;
}

.h2w-light .h2w__g-callout.callout--green { border-left-color:#16a085; }
.h2w-light .h2w__g-callout.callout--orange { border-left-color:#d35400; }
.h2w-light .h2w__g-callout.callout--yellow { border-left-color:#d4ac0d; }
.h2w-light .h2w__g-callout.callout--red { border-left-color:#c0392b; }
.h2w-light .h2w__g-callout.callout--blue { border-left-color:#2980b9; }

.h2w-light .h2w__u.blank-underline {
  color:#0080ff;
  border-bottom-color:#0080ff;
  background-color:#d9ecff;
}

.h2w-light .h2w__lineNum {
    color:#ccc;
}

/**代码高亮样式**/
@import '../../parse/highlight/style/github.wxss';
